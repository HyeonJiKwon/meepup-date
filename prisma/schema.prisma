// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id             String        @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  candidateDates DateTime[]    @default([]) @db.Date
  /// Per-date opponent/stadium info for team-created events, keyed by yyyy-MM-dd.
  gameInfo       Json?
  deadline       DateTime?
  createdAt      DateTime      @default(now())
  participants   Participant[]
}

model Participant {
  id             String     @id @default(cuid())
  eventId        String
  event          Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  pinHash        String
  availableDates DateTime[] @db.Date
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([eventId, name])
}

model KboGame {
  id       String   @id @default(cuid())
  date     DateTime @db.Date
  homeTeam String
  awayTeam String
  stadium  String

  @@unique([date, homeTeam])
}

/// IP rate limit / PIN failure lockout buckets for participant submit.
model AuthThrottle {
  id          String    @id
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}
